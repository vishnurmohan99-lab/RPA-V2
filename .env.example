# Copy to .env for local overrides. Never commit real values.

# Port the server (API + built web app) listens on. Hosts like Render set this for you.
PORT=3001

# Where saved automations, run history and kept files live.
# Locally this defaults to ./server. When hosted, point it at a persistent disk.
# ATLAS_DATA_ROOT=/data

# Where the built web app is. Defaults to web/dist next to the server.
# WEB_DIST=./web/dist

# Real-browser runner (not built yet). These stay out of the app, the automations and run history.
# PS_BASE_URL=
# PS_USER=
# PS_PASS=
