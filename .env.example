# Copy to .env for local overrides. Never commit real values.

# Port the server (API + built web app) listens on. Hosts like Render set this for you.
PORT=3001

# Where saved automations, run history and kept files live when Supabase (below) isn't
# configured: local JSON files + local disk. Locally this defaults to ./server; when hosted
# without Supabase, point it at a persistent disk.
# ATLAS_DATA_ROOT=/data

# Supabase: workflows, house rules, sign-ins and run history live in Postgres, kept files in
# Supabase Storage (bucket "files"), instead of local JSON files and disk. Set both to use it —
# with neither set, the server falls back to local files automatically (see ATLAS_DATA_ROOT
# above), so this is optional for local dev. Use the service_role secret key, never the anon/
# publishable one — it's what lets the server bypass Row Level Security as the trusted backend.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Where the built web app is. Defaults to web/dist next to the server.
# WEB_DIST=./web/dist

# The real-browser runner's sign-in passwords. Each saved sign-in (Sign-ins page) gets its own
# variable: strip its "cred-" prefix, uppercase it, and prefix with ATLAS_CRED_.
#   cred-billing-ro  -> ATLAS_CRED_BILLING_RO
#   cred-posting     -> ATLAS_CRED_POSTING
# The workflow only ever stores the sign-in's name; the password lives here and nowhere else.
# ATLAS_CRED_BILLING_RO=
# ATLAS_CRED_POSTING=
